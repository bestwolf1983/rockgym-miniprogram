/* 通行证状态卡。所有值来自 tokens，禁止硬编码色值（CI 有正则拦截） */

.ac-wrap { display: flex; flex-direction: column; }

/* --- 待确认消费黄条 --- */
.ac-confirm {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--c-warn-soft);
  color: var(--c-warn-ink);
  border-radius: var(--r-md);
  padding: 18rpx 24rpx;
  font-size: var(--f-cap);
  margin-bottom: var(--s-2);
}
.ac-confirm-cta { font-weight: 600; }

/* --- 卡片本体 --- */
.ac-card {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-xl);
  padding: var(--s-4);
  padding-left: calc(var(--s-4) + 6rpx);
  box-shadow: var(--sh-card);
  /* 状态色渐变而非闪切 */
  transition: background var(--m-base) var(--m-ease);
}

/* 左侧状态条 */
.ac-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
}

.ac-card.state-none    { background: var(--c-surface); }
.ac-card.state-none::before    { background: var(--c-text-3); }
.ac-card.state-pass    { background: var(--c-pass-soft); }
.ac-card.state-pass::before    { background: var(--c-pass); }
.ac-card.state-pending { background: var(--c-warn-soft); }
.ac-card.state-pending::before { background: var(--c-warn); }
.ac-card.state-expired { background: var(--c-block-soft); }
.ac-card.state-expired::before { background: var(--c-block); }

.ac-head { display: flex; align-items: center; }
.ac-title { font-size: var(--f-h2); font-weight: 600; margin-left: 14rpx; }

.ac-dot { width: 18rpx; height: 18rpx; border-radius: var(--r-full); flex: none; }
.ac-card.state-none .ac-dot    { background: var(--c-text-3); }
.ac-card.state-pass .ac-dot    { background: var(--c-pass); box-shadow: 0 0 0 8rpx rgba(34, 197, 94, .16); }
.ac-card.state-pending .ac-dot { background: var(--c-warn); box-shadow: 0 0 0 8rpx rgba(245, 158, 11, .16); }
.ac-card.state-expired .ac-dot { background: var(--c-block); box-shadow: 0 0 0 8rpx rgba(240, 78, 78, .16); }

.ac-quals { display: flex; flex-wrap: wrap; margin-top: var(--s-3); }
.ac-chip {
  font-size: var(--f-cap);
  padding: 8rpx 20rpx;
  border-radius: var(--r-full);
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  background: var(--c-surface-sunken);
  color: var(--c-text-2);
}
.ac-chip-pass  { background: var(--c-pass-soft);  color: var(--c-pass-ink); }
.ac-chip-warn  { background: var(--c-warn-soft);  color: var(--c-warn-ink); }
.ac-chip-block { background: var(--c-block-soft); color: var(--c-block-ink); }

.ac-meta { margin-top: var(--s-2); }
.ac-meta-line {
  display: block;
  font-size: var(--f-cap);
  color: var(--c-text-2);
  line-height: 1.7;
}

.ac-btn {
  margin-top: var(--s-4);
  width: 100%;
  height: 92rpx;
  border-radius: var(--r-full);
  font-size: var(--f-body);
  font-weight: 600;
  color: var(--c-text-inverse);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ac-btn::after { border: none; }
.ac-btn-primary { background: var(--c-primary); box-shadow: var(--sh-rise); }
.ac-btn-warn    { background: var(--c-warn); }
.ac-btn-block   { background: var(--c-block); }
/* 点击缩放至 0.97，不超过 400ms */
.ac-btn-hover { transform: scale(.97); transition: transform var(--m-fast) var(--m-ease); }

/* --- 骨架屏 --- */
.ac-skeleton { background: var(--c-surface); }
.sk-line { height: 28rpx; border-radius: var(--r-sm); background: var(--c-surface-sunken); margin-bottom: 16rpx; }
.sk-w40 { width: 40%; }
.sk-w70 { width: 70%; }
.sk-w55 { width: 55%; }
.sk-btn { height: 92rpx; border-radius: var(--r-full); background: var(--c-surface-sunken); margin-top: var(--s-4); }
