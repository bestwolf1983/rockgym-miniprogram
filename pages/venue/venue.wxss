/* scroll-view 需要确定高度才能算滚动范围；min-height 会被内容撑开，
   导致滑到底后回滑卡住。固定 100vh，内容在容器内滚。 */
.page { height: 100vh; box-sizing: border-box; padding-top: 24rpx; }

.pt { display: block; font-size: var(--f-h1); font-weight: 600; letter-spacing: -1rpx; }
.pt-sub { display: block; font-size: var(--f-sub); color: var(--c-text-2); margin: 8rpx 0 28rpx; }

.vn {
  background: var(--c-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
  overflow: hidden;
  margin-bottom: 24rpx;
}

/* 照片：裁剪成固定的宽高比，四家店的图源尺寸一致，避免列表参差 */
.vn-photo { position: relative; width: 100%; height: 320rpx; }
.vn-img { width: 100%; height: 100%; display: block; }

/* 当前门店角标：用主色实心，区别于"即将开通"的灰卡 */
.vn-badge {
  position: absolute;
  left: 20rpx; top: 20rpx;
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--r-full, 999rpx);
  background: var(--c-primary-strong, #1FA98F);
  color: #FFFFFF;
  font-weight: 600;
}

.vn-body { padding: 24rpx 28rpx 26rpx; }

.vn-name { display: block; font-size: 32rpx; font-weight: 600; letter-spacing: -.5rpx; }
.is-soon .vn-name { color: var(--c-text-2); }

.vn-addr {
  display: block;
  font-size: var(--f-cap);
  color: var(--c-text-3);
  line-height: 1.6;
  margin-top: 8rpx;
}

.vn-foot { display: flex; gap: 10rpx; margin-top: 18rpx; }

.chip { font-size: 21rpx; padding: 6rpx 18rpx; border-radius: var(--r-full, 999rpx);
  background: var(--c-surface-sunken); color: var(--c-text-2); }
.chip-on { background: var(--c-pass-soft); color: var(--c-pass-ink); }

/* 未开通的店整体降对比：不是不可用，是"还没到" */
.is-soon { box-shadow: none; background: var(--c-surface-sunken); }

.tile-hover { opacity: .7; }
