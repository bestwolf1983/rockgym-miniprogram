/* scroll-view 需要确定高度才能算滚动范围；min-height 会被内容撑开，
   导致滑到底后回滑卡住。固定 100vh，内容在容器内滚。 */
.page { height: 100vh; box-sizing: border-box; padding-top: 24rpx; }

.pt { display: block; font-size: var(--f-h1); font-weight: 600; letter-spacing: -1rpx; }

/* 用户头 */
.me { display: flex; align-items: center; gap: 26rpx; padding: 32rpx 0 12rpx; }
.me-av {
  width: 104rpx; height: 104rpx; border-radius: var(--r-full); flex: 0 0 auto;
  background: linear-gradient(135deg, var(--c-primary) 0%, var(--c-primary-strong) 100%);
  color: #fff; font-size: 42rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--sh-rise);
}
.me-info { min-width: 0; }
.me-name { display: block; font-size: 38rpx; font-weight: 600; letter-spacing: -1rpx; }
.me-sub { display: block; font-size: var(--f-cap); color: var(--c-text-2); margin-top: 6rpx; }

.section-title { display: flex; align-items: baseline; justify-content: space-between; margin: 48rpx 0 24rpx; }
.section-h { font-size: var(--f-h2); font-weight: 600; }
.section-more { font-size: var(--f-cap); color: var(--c-text-3); }

/* 卡包 */
.wallet {
  border-radius: var(--r-lg); padding: 32rpx; color: #fff;
  box-shadow: var(--sh-rise);
  background: linear-gradient(135deg, var(--c-primary) 0%, var(--c-primary-strong) 100%);
  margin-bottom: 20rpx;
}
.wallet.month {
  background: linear-gradient(135deg, var(--c-accent) 0%, var(--c-accent-strong) 100%);
  box-shadow: 0 16rpx 52rpx rgba(224, 162, 78, .28);
}
/* 待激活：未满足安全要求，压低一档避免误导为"可用" */
.wallet.pending { background: linear-gradient(135deg, #9AA8A5 0%, #788784 100%); box-shadow: none; }

.w-name { display: block; font-size: var(--f-sub); font-weight: 600; }
.w-big { display: block; font-size: 52rpx; font-weight: 700; letter-spacing: -2rpx; margin-top: 6rpx; }
.w-meta { display: block; font-size: 20rpx; opacity: .88; margin-top: 12rpx; line-height: 1.7; }

/* 安全合规待办 */
.todo { background: var(--c-warn-soft); border-radius: var(--r-lg); padding: 26rpx 30rpx; margin-bottom: 20rpx; }
.todo-h { display: block; font-size: var(--f-cap); font-weight: 600; color: var(--c-warn-ink); margin-bottom: 14rpx; }
.todo-item { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 0; }
.todo-k {
  width: 38rpx; height: 38rpx; border-radius: var(--r-full); flex: 0 0 auto;
  background: var(--c-warn); color: #fff; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.todo-m { flex: 1; min-width: 0; }
.todo-t { display: block; font-size: var(--f-sub); font-weight: 600; color: var(--c-warn-ink); }
.todo-s { display: block; font-size: 20rpx; color: var(--c-text-2); margin-top: 4rpx; }

/* 退费试算 */
.calc { background: var(--c-surface); border-radius: var(--r-lg); box-shadow: var(--sh-card); overflow: hidden; margin-bottom: 24rpx; }
.calc-h { display: block; font-size: 21rpx; color: var(--c-text-3); padding: 20rpx 32rpx 0; }
.calc-r { display: flex; align-items: baseline; justify-content: space-between; padding: 16rpx 32rpx; font-size: 24rpx; }
.calc-r text:first-child { color: var(--c-text-2); }
.calc-r.minus text:last-child { color: var(--c-block); }
.calc-r.total { background: var(--c-primary-soft); padding: 22rpx 32rpx; }
.calc-r.total text:last-child { font-size: 34rpx; color: var(--c-primary-strong); font-weight: 700; }

/* B 端入口：不抢 C 端视觉 —— 小字 + 弱化底色，放页尾 */
.staff-entry {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: var(--s-4);
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--c-surface-sunken);
}
.se-t { font-size: var(--f-cap); color: var(--c-text-2); }
.se-s { font-size: 20rpx; color: var(--c-text-3); }

/* 游客登录引导 */
.login-btn {
  margin-top: var(--s-3);
  background: linear-gradient(135deg, var(--c-primary) 0%, var(--c-primary-strong) 100%);
  color: #fff; font-size: var(--f-sub); font-weight: 600;
  border-radius: var(--r-full);
  box-shadow: var(--sh-rise);
}
.login-btn::after { border: none; }
.login-tip {
  display: block; text-align: center;
  font-size: var(--f-cap); color: var(--c-text-3);
  margin-top: var(--s-2);
}
