/* scroll-view 需要确定高度才能算滚动范围；min-height 会被内容撑开，
   导致滑到底后回滑卡住。固定 100vh，内容在容器内滚。 */
.page { height: 100vh; box-sizing: border-box; padding-top: 24rpx; }

.pt { display: block; font-size: var(--f-h1); font-weight: 600; letter-spacing: -1rpx; }
.pt-sub { display: block; font-size: var(--f-sub); color: var(--c-text-2); margin: 8rpx 0 28rpx; }

/* 备案状态横幅 */
.filing { border-radius: var(--r-lg); padding: 22rpx 28rpx; margin-bottom: 28rpx;
  background: var(--c-warn-soft); color: var(--c-warn-ink); }
.filing.is-filed { background: var(--c-pass-soft); color: var(--c-pass-ink); }
.filing-b { display: block; font-size: var(--f-sub); font-weight: 600; }
.filing-s { display: block; font-size: var(--f-cap); margin-top: 6rpx; line-height: 1.6; opacity: .92; }

/* 卡种 */
.prod { background: var(--c-surface); border-radius: var(--r-lg); padding: 28rpx;
  box-shadow: var(--sh-card); margin-bottom: 20rpx; }
.prod.locked { background: var(--c-surface-sunken); box-shadow: none; }
.p-name { font-size: 30rpx; font-weight: 600; }
.prod.locked .p-name { color: var(--c-text-3); }
.p-price { display: block; font-size: 46rpx; font-weight: 700; letter-spacing: -1.5rpx; margin-top: 6rpx; }
.prod.locked .p-price { color: var(--c-text-3); }
.p-small { font-size: 20rpx; font-weight: 400; color: var(--c-text-3); margin-left: 8rpx; letter-spacing: 0; }

.p-attrs { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.chip { font-size: 21rpx; padding: 6rpx 18rpx; border-radius: var(--r-full);
  background: var(--c-surface-sunken); color: var(--c-text-2); }
.chip-pass { background: var(--c-pass-soft); color: var(--c-pass-ink); }

.p-lock { display: block; font-size: 21rpx; color: var(--c-text-3); line-height: 1.7;
  margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid var(--c-line); }

/* 公示 */
.disclosure { display: flex; align-items: center; justify-content: space-between;
  margin-top: 44rpx; padding: 26rpx 28rpx; background: var(--c-surface);
  border-radius: var(--r-lg); box-shadow: var(--sh-card); }
.disclosure-text { font-size: var(--f-cap); color: var(--c-text-2); }
.chev { font-size: 32rpx; color: var(--c-text-3); }

.tile-hover { opacity: .7; }
