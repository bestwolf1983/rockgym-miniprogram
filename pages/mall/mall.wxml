<!--
  商城 —— 购卡。
  能不能卖完全由服务端的 listed 字段决定：备案未完成时受监管卡种自动置灰，
  页面不判断任何备案逻辑。
-->
<scroll-view scroll-y class="page" refresher-enabled bind:refresherrefresh="onPullDownRefresh">
  <view class="page-pad">
    <text class="pt">购卡</text>
    <text class="pt-sub">按次或按时长，随买随用</text>

    <!-- 备案状态横幅（PRD 第 7 章 · 分段上线） -->
    <view class="filing {{filed ? 'is-filed' : ''}}">
      <text class="filing-b">{{filed ? '已完成预付卡备案' : '备案办理中'}}</text>
      <text class="filing-s">{{filed ? '全部卡种正常销售' : lockedCount + ' 种预付类卡种暂未开售，单次票可正常购买'}}</text>
    </view>

    <!-- 卡种 -->
    <view
      wx:for="{{cardProducts}}"
      wx:key="id"
      class="prod {{item.listed ? '' : 'locked'}}"
      data-id="{{item.id}}"
      data-listed="{{item.listed}}"
      bind:tap="onProductTap"
      hover-class="tile-hover"
    >
      <view class="row">
        <view>
          <text class="p-name">{{item.name}}</text>
          <text class="p-price">¥{{item.price}}<text wx:if="{{item.times}}" class="p-small">均价 {{item.price / item.times}}/次</text><text wx:elif="{{item.durationDays}}" class="p-small">/{{item.durationDays}} 天</text></text>
        </view>
        <text class="chip {{item.listed ? 'chip-pass' : ''}}">{{item.listed ? '可购买' : '备案中'}}</text>
      </view>

      <view class="p-attrs">
        <text wx:if="{{item.validDays}}" class="chip">{{item.validDays}} 天有效</text>
        <text wx:if="{{item.bindHolder}}" class="chip">记名 · 人卡绑定</text>
        <text wx:if="{{item.transferable}}" class="chip">可转让 · 每日 {{item.dailyTransferLimit}} 次</text>
        <text wx:else class="chip">不可转让</text>
      </view>

      <text wx:if="{{!item.listed}}" class="p-lock">该卡种属{{item.type === 'MONTH' || item.type === 'SEASON' ? '会籍' : '课时'}}类预付消费，须完成体育行业预付卡备案与资金存管后开售</text>
    </view>

    <!-- 合规公示（PAY-05）：细则第九条要求显著位置 -->
    <view class="disclosure" bind:tap="onDisclosureTap" hover-class="tile-hover">
      <text class="disclosure-text">备案信息 · 收费标准 · 退费办法 · 投诉电话</text>
      <text class="chev">›</text>
    </view>
  </view>

  <view class="tabbar-spacer"></view>
</scroll-view>
