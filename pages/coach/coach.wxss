/* 教练详情（PQ-1） */
.coach-page { padding: 32rpx; }

.cs-loading, .cs-empty {
  padding: 60rpx 0; text-align: center;
  font-size: 26rpx; color: var(--c-text-3);
}

.cs-head { display: flex; align-items: center; gap: 24rpx; padding: 8rpx 0 32rpx; }
.cs-avatar {
  width: 120rpx; height: 120rpx;
  border-radius: var(--r-full); flex: none;
}
.cs-id { flex: 1; min-width: 0; }
.cs-name-row { display: flex; align-items: center; gap: 16rpx; }
.cs-name { font-size: 34rpx; font-weight: 600; }
.cs-badge {
  font-size: 20rpx; font-weight: 600;
  padding: 6rpx 14rpx; border-radius: var(--r-full);
}
.cs-tag { display: block; font-size: 24rpx; color: var(--c-text-2); margin-top: 8rpx; }

.cs-stats {
  display: flex; padding: 28rpx 0;
  border-top: 1rpx solid var(--c-line);
  border-bottom: 1rpx solid var(--c-line);
}
.cs-stat { flex: 1; text-align: center; }
.cs-stat-n {
  display: block; font-size: 36rpx; font-weight: 600; color: var(--c-primary-strong);
}
.cs-stat-l { font-size: 21rpx; color: var(--c-text-3); }

.cs-sec { margin-top: 32rpx; }
.cs-sec-t { display: block; font-size: 22rpx; color: var(--c-text-3); margin-bottom: 14rpx; }
.cs-chips { display: flex; flex-wrap: wrap; gap: 10rpx; }
.cs-chip {
  font-size: 22rpx; padding: 10rpx 20rpx;
  border-radius: var(--r-full);
  background: var(--c-surface-sunken); color: var(--c-text-2);
}
.cs-chip.is-pass { background: var(--c-pass-soft); color: var(--c-pass-ink); }

.cs-note {
  margin-top: 36rpx; padding: 24rpx;
  font-size: 24rpx; color: var(--c-text-2); line-height: 1.7;
  background: var(--c-surface-sunken); border-radius: var(--r-md);
}
.cs-tel { color: var(--c-primary-strong); font-weight: 600; }

.cs-btn {
  margin-top: 32rpx;
  background: var(--c-primary); color: var(--c-text-inverse);
  font-size: 28rpx; font-weight: 600;
  border-radius: var(--r-md); padding: 24rpx 0;
}
.cs-btn::after { border: none; }
