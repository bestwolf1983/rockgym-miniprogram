# 配置清单（占位说明，全部注释掉；真实值一律不进仓库）
# 小程序端实际读取 services/config.private.ts，本文件仅列出需要具备的配置项。

# --- 小程序端：对应 services/config.private.ts ---
# CLOUDBASE_ENV_ID=<your-cloudbase-env-id>
# CLOUDBASE_PUBLISHABLE_KEY=<anon-publishable-key>
# CLOUDBASE_API_BASE=https://<your-env>.ap-shanghai.app.tcloudbase.com
# ASSET_CDN_BASE=https://<your-static-host>

# --- 可选：同时部署后端 API 时才需要 ---
# DATABASE_URL=postgresql://<user>:<pass>@127.0.0.1:5432/<db>
# REDIS_URL=redis://127.0.0.1:6379
# FIELD_ENCRYPTION_KEY=<32-byte-base64>
# FIELD_HASH_SALT=<random-salt>
